{
  "name": "nwis-backend",
  "version": "1.0.0",
  "description": "eRTMAC-NWIS Backend — AI-powered offset well intelligence platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:setup": "tsx scripts/setupDatabase.ts",
    "db:seed": "tsx scripts/runSeeds.ts",
    "qdrant:setup": "tsx scripts/setupQdrant.ts",
    "setup": "npm run db:setup && npm run qdrant:setup && npm run db:seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.7.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
