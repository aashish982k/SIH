{
  "name": "nwis-backend",
  "version": "1.0.0",
  "description": "eRTMAC-NWIS Backend — AI-powered offset well intelligence platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setupDatabase.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/runSeeds.ts",
    "kb:index": "tsx scripts/indexKnowledge.ts",
    "samples": "tsx scripts/makeSampleReports.ts",
    "setup": "npm run db:setup && npm run db:seed && npm run kb:index && npm run samples",
    "demo:reset": "tsx scripts/resetDemo.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
