PORT=5000
NODE_ENV=development

# MySQL (docker-compose maps the container to host port 3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=nwis_user
MYSQL_PASSWORD=nwis_pass
MYSQL_DATABASE=nwis
MYSQL_ROOT_PASSWORD=secret

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nwis_knowledge

# Local embeddings (downloaded once, then cached in node_modules/.cache)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Groq — report extraction and cited answers. Get a key at https://console.groq.com/keys
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

DEFAULT_RADIUS_KM=10
UPLOADS_DIR=./uploads
CORS_ORIGIN=http://localhost:3000
