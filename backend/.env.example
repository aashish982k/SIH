PORT=5000
NODE_ENV=development

# MySQL (matches docker-compose.yml defaults)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nwis_user
MYSQL_PASSWORD=nwis_pass
MYSQL_DATABASE=nwis
MYSQL_ROOT_PASSWORD=secret

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nwis_knowledge
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (RAG risk reasoning/chat)
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-20b
GROK_BASE_URL=https://api.groq.com/openai/v1
RAG_RISK_TOP_K=8

# OpenAI embeddings are an optional fallback. If no Gemini or OpenAI key is
# configured, the backend uses a deterministic local vector.
OPENAI_API_KEY=

# File uploads
UPLOADS_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000
