PORT=5000
NODE_ENV=development

# PostgreSQL — single connection string
# Local:  postgresql://nwis_user:nwis_pass@127.0.0.1:5432/nwis
# Neon:   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/nwis?sslmode=require
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://nwis_user:nwis_pass@127.0.0.1:5432/nwis

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nwis_knowledge

# Local embeddings (downloaded once, then cached in node_modules/.cache)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Groq — report extraction and cited answers. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DEFAULT_RADIUS_KM=10
UPLOADS_DIR=./uploads
CORS_ORIGIN=http://localhost:3000
