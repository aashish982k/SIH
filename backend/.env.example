PORT=5000
NODE_ENV=development

# MySQL (matches docker-compose.yml defaults)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nwis_user
MYSQL_PASSWORD=nwis_pass
MYSQL_DATABASE=nwis
MYSQL_ROOT_PASSWORD=secret

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nwis_knowledge
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=grok-embedding

# Grok / xAI (for embeddings — fill in when ready)
GROK_API_KEY=

# OpenAI (fallback for embeddings)
OPENAI_API_KEY=

# File uploads
UPLOADS_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000
